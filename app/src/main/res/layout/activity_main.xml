<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    android:gravity="center"

    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="@string/titre_imc"
        android:textSize="28sp"
        android:textStyle="bold"

        android:layout_marginBottom="30dp" />


    <EditText
        android:id="@+id/editTextPoids"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:hint="@string/hint_poids"
        android:inputType="numberDecimal"

        android:layout_marginBottom="15dp" />


    <EditText
        android:id="@+id/editTextTaille"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:hint="@string/hint_taille"
        android:inputType="numberDecimal"

        android:layout_marginBottom="20dp" />


    <Button
        android:id="@+id/buttonCalculer"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="@string/button_calculer" />


    <Button
        android:id="@+id/buttonEffacer"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="@string/button_effacer"

        android:layout_marginTop="10dp"
        android:layout_marginBottom="30dp" />


    <TextView
        android:id="@+id/textViewImc"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:textSize="30sp"
        android:textStyle="bold"

        android:layout_marginBottom="15dp" />


    <TextView
        android:id="@+id/textViewCategorie"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>